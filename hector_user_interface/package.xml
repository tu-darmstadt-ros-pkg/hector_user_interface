<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hector_user_interface</name>
  <version>0.0.0</version>
  <description>The hector_user_interface package</description>

  <maintainer email="fabian@sim.tu-darmstadt.de">Stefan Fabian</maintainer>

  <license>GPLv3</license>

  <author email="fabian@sim.tu-darmstadt.de">Stefan Fabian</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hector_rviz_overlay</depend>
  <depend>moveit_ros_visualization</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>urdf</depend>
  <depend>sensor_msgs</depend>
  <depend>rviz2</depend>
  <depend>rviz_common</depend>
  <depend>rviz_default_plugins</depend>
  <depend>rviz_rendering</depend>
  <exec_depend>ros_camera_server_qml</exec_depend>
  <exec_depend>hector_internal_qml_controls</exec_depend>
  <exec_depend>hector_qml_controls</exec_depend>
  <exec_depend>hector_user_interface_resources</exec_depend>
  <exec_depend>libqt5-qml</exec_depend>
  <exec_depend>qml-module-qtmultimedia</exec_depend>
  <exec_depend>qml-module-qtquick-controls2</exec_depend>
  <exec_depend>qml-module-qtquick-layouts</exec_depend>
  <exec_depend>qml-module-qtquick2</exec_depend>
  <exec_depend>qml_ros2_plugin</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <!-- Messages required by UI -->
  <exec_depend>hector_user_interface_msgs</exec_depend>
  <exec_depend>hector_gamepad_manager_msgs</exec_depend>

  <!-- The export tag contains other, unspecified, tags -->
  <export>
    <build_type>ament_cmake</build_type>
    <rviz plugin="${prefix}/rviz_common_plugins.xml"/>
  </export>
</package>
